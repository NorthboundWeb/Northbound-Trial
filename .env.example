# Copy to .env.local for development. Never commit .env.local — it is gitignored.
# In Vercel these live in Project → Settings → Environment Variables.
# Every value here is server-side only. Do not rename any of them to NEXT_PUBLIC_*:
# that prefix ships the value to the browser.

# Supabase project that holds the nb_booking schema (see supabase/booking.sql).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# The owner secret the nb_booking_admin_* functions check. The database keeps
# only its SHA-256 hash, in nb_booking.config.
NB_ADMIN_SECRET=

# The password typed on /diary, and the key that signs the diary cookie.
DIARY_PASSWORD=
DIARY_SESSION_KEY=
